<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Círculo de fondo oscuro (el "riel" vacío) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/card_light" />
            <stroke
                android:width="4dp"
                android:color="#40befd " />
        </shape>
    </item>

    <!-- Efecto de brillo/gradiente central -->
    <item
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#003D85E1"
                android:centerColor="#203D85E1"
                android:startColor="#0227ac "
                android:gradientRadius="120dp"
                android:type="radial" />
        </shape>
    </item>

    <!-- Borde exterior fino para resaltar -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#0227ac" />
        </shape>
    </item>
</layer-list>